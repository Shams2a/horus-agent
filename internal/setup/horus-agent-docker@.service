[Unit]
Description=Horus Network monitoring agent, lecture Docker (une connexion)

# Lancé par horus-agent-docker.socket. Ne lit rien de ce que l'agent envoie :
# il interroge Docker avec deux requêtes fixes (liste et inspection des
# conteneurs, en lecture seule) et renvoie le résultat filtré.
[Service]
ExecStart=/opt/horus-agent/bin/horus-agent docker-read
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=30

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
